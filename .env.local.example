# ==============================================================================
# Bonsai Harness — Local Override Template
# ==============================================================================
# Copy this file to `.env.local` and fill in your API key for OpenAI-compatible
# inference. `.env.local` is gitignored and will NOT be committed.
#
# Bun loads env files in this precedence order (first wins):
#   .env.local  →  .env.development  →  .env.production  →  .env
#
# This means `.env.local` is the right place to:
#   - Override the default local-command runtime with an API runtime
#   - Stash a personal API key without touching `.env`
#   - Point the backend at a different inference provider (Ollama, LM Studio,
#     OpenRouter, OpenAI, Anthropic-compatible gateways, etc.)
# ==============================================================================

# ─── Option A: OpenAI-compatible API ──────────────────────────────────────────
# Use any service that exposes a /v1/chat/completions-style endpoint.
# Examples: OpenAI, OpenRouter, Together, Groq, local Ollama (with proxy),
# LM Studio, vLLM, llama.cpp server, etc.

HARNESS_RUNTIME_KIND=openai-compatible
HARNESS_API_BASE_URL=https://api.openai.com
HARNESS_API_PATH=/v1/chat/completions
HARNESS_API_KEY=sk-replace-with-your-key
HARNESS_MODEL_ID=gpt-4o-mini
HARNESS_API_MAX_TOKENS=512
HARNESS_API_TEMPERATURE=0.2

# ─── Option B: Local OpenAI-compatible server (no key required) ───────────────
# Uncomment to point at LM Studio, Ollama (with `ollama serve`), or vLLM:
#
# HARNESS_RUNTIME_KIND=openai-compatible
# HARNESS_API_BASE_URL=http://localhost:11434
# HARNESS_API_PATH=/v1/chat/completions
# HARNESS_API_KEY=not-needed
# HARNESS_MODEL_ID=llama3.2:3b

# ─── Option C: Anthropic via OpenAI-compatible proxy ──────────────────────────
# Use a gateway like LiteLLM or Portkey to expose Anthropic as OpenAI shape:
#
# HARNESS_RUNTIME_KIND=openai-compatible
# HARNESS_API_BASE_URL=https://api.your-litellm-gateway.example.com
# HARNESS_API_PATH=/v1/chat/completions
# HARNESS_API_KEY=sk-your-gateway-key
# HARNESS_MODEL_ID=claude-3-5-sonnet-20241022

# ─── Option D: Anthropic native API (no proxy needed) ─────────────────────────
# Use Anthropic's Messages API directly via the dedicated runtime:
#
# HARNESS_RUNTIME_KIND=anthropic
# ANTHROPIC_API_KEY=sk-ant-replace-with-your-key
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_MAX_TOKENS=1024
# ANTHROPIC_API_TEMPERATURE=0.7
# HARNESS_MODEL_ID=claude-sonnet-4-20250514

# ─── Frontend hint ────────────────────────────────────────────────────────────
# The frontend never sees the API key. It only needs to know the backend URL.
VITE_HARNESS_BACKEND_URL=http://localhost:11431

# ─── Notes ────────────────────────────────────────────────────────────────────
# - HARNESS_API_KEY and ANTHROPIC_API_KEY MUST stay server-side. Never put
#   either in `frontend/.env*`.
# - Both OpenAI-compatible and Anthropic keys can coexist in `.env.local` —
#   switching HARNESS_RUNTIME_KIND selects which provider is active.
# - HARNESS_RUNTIME_KIND in `.env.local` overrides the local-command default
#   from `.env` whenever this file is present.
# - The settings pane writes to `backend/.env.local` on save.
