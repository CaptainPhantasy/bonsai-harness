PORT=11431
HARNESS_BIND_HOST=127.0.0.1
HARNESS_MODEL_ID=gpt-4o-mini
HARNESS_RUNTIME_KIND=openai-compatible
HARNESS_MAX_ACTIVE_AGENTS=2
HARNESS_SANDBOX_ROOT=/Volumes/SanDisk1Tb/bonsai-harness/sandbox

# OpenAI-compatible runtime. Keep HARNESS_API_KEY server-side only.
HARNESS_API_BASE_URL=https://api.openai.com
HARNESS_API_PATH=/v1/chat/completions
HARNESS_API_KEY=replace-with-server-side-key
HARNESS_API_MAX_TOKENS=256
HARNESS_API_TEMPERATURE=0.2

# Native Anthropic runtime (set HARNESS_RUNTIME_KIND=anthropic to use).
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=replace-with-server-side-key
# ANTHROPIC_API_MAX_TOKENS=1024
# ANTHROPIC_API_TEMPERATURE=0.7
