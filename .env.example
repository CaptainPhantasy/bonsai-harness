PORT=11431
HARNESS_MODEL_ID=prism-ml/Ternary-Bonsai-8B-mlx-2bit
HARNESS_RUNTIME_KIND=local-command
HARNESS_MAX_ACTIVE_AGENTS=2
HARNESS_SANDBOX_ROOT=/Volumes/SanDisk1Tb/bonsai-harness/sandbox
HARNESS_RUNNER_BINARY=/opt/homebrew/bin/mlx_lm
HARNESS_RUNNER_ARGS_TEMPLATE=generate --model {{modelId}} --prompt {{prompt}} --verbose False
HARNESS_MODEL_CACHE_DIR=/Volumes/SanDisk1Tb/HFModels
HARNESS_CACHE_DIR=/Volumes/SanDisk1Tb/mlx-cache
VITE_HARNESS_BACKEND_URL=http://localhost:11431

# OpenAI-compatible runtime; keep API key server-side.
# HARNESS_RUNTIME_KIND=openai-compatible
# HARNESS_API_BASE_URL=https://api.openai.com
# HARNESS_API_PATH=/v1/chat/completions
# HARNESS_API_KEY=replace-with-server-side-key
